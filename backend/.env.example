# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# AlloyDB / PostgreSQL Connection String
# Example: postgresql://postgres:password@1.2.3.4:5432/closetmind
MCP_TOOLBOX_AlloyDB_POSTGRES_URL=postgresql://user:password@host:port/dbname

# Google Calendar OAuth Token JSON String
# Copy the entire content of token.json into this variable (as a one-line string)
GOOGLE_CALENDAR_TOKEN='{"token": "...", "refresh_token": "...", ...}'

# Backend Base URL (for self-referencing if needed)
BASE_URL=http://localhost:8000

# Weather API (Optional override)
# WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
